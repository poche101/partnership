APP_NAME="Partnership Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite database (default). The file is created automatically by
# `php artisan migrate` if it does not exist yet.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# Optional: enables AI-powered semantic partner search and AI-written
# giving statements on the Search / Statements pages. Leave blank to
# fall back to plain substring search and a templated statement letter.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Seeded zone super-admin login (php artisan db:seed)
SEED_SUPERADMIN_EMAIL=superadmin@partnership.app
SEED_SUPERADMIN_PASSWORD="SuperAdmin#2026"

VITE_APP_NAME="${APP_NAME}"
